# Copy this to .env and fill it in. NEVER commit the real .env.
#
# On Windows, generate the three secrets with:
#   powershell -Command "-join ((1..16) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })"
# Or just run setup_env.ps1, which generates them and prompts for the NAS
# login, then locks the file to your account.

# This instance's own secrets. Do NOT reuse the ones from your NAS
# instance - two instances should never share credentials.
APP_KEY=replace-with-a-long-random-string
DB_ROOT_PASSWORD=replace-with-random-hex
DB_PASSWORD=replace-with-random-hex

# The NAS login, used only to mount the archive share READ-ONLY.
# This is the account you sign in to the NAS web UI with - on UGREEN
# that is the NAS account name, not your email.
NAS_USER=your-nas-username
NAS_PASSWORD=your-nas-password

# Where your existing Project NOMAD lives, and the SMB share that holds
# its storage folder. On a UGREEN NAS the share is usually "docker" and
# NOMAD sits in project-nomad inside it, giving:
#     //192.168.1.50/docker/project-nomad/storage/zim
NAS_HOST=192.168.1.50
NAS_SHARE=docker/project-nomad
