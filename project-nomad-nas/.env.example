# Copy to .env beside the compose file and fill in. NEVER commit the real one.
#
# Generate each password fresh - do not reuse them across instances:
#   openssl rand -hex 16

APP_URL=http://YOUR_NAS_IP:8080
NODE_ENV=production
LOG_LEVEL=info

# Database
MYSQL_ROOT_PASSWORD=generate-a-random-string
MYSQL_DATABASE=nomad
MYSQL_USER=nomad_user
MYSQL_PASSWORD=generate-a-different-random-string

# Cache
REDIS_HOST=redis
REDIS_PORT=6379

# Local LLM
OLLAMA_HOST=http://ollama:11434
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=1

# Vector database for semantic search over the library
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=generate-a-random-string

# Ports published on the NAS
ADMIN_PORT=8080
KIWIX_PORT=8090
DOZZLE_PORT=9999
OLLAMA_PORT=11434
DOZZLE_LEVEL=info

# Only needed by the generic docker-compose.yaml
APP_KEY=generate-a-long-random-string
NAS_HOST=YOUR_NAS_IP
